{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyThisRepositoryOnItsMainBranch",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::__ACCOUNT__:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:__OWNER__@__OWNER_ID__/__REPO__@__REPO_ID__:ref:refs/heads/__BRANCH__"
        }
      }
    }
  ]
}
