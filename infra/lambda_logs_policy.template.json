{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteLogsToItsOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/aws/lambda/__FUNCTION__:*"
    }
  ]
}
